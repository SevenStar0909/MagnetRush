--- !u!114 &1972788617
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1972788616}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 186311647da348045aeb2e4edece70ff, type: 3}
  m_Name: 
  m_EditorClassIdentifier: MagnetRush.UI::SimpleTutorial
  tutorialText: {fileID: 1945699973}
  commentBoardObject: {fileID: 1661143234}
  defaultTextSpeed: 0.05
  phase1_Opening:
  - message: "\u30FC\u901A\u4FE1\u78BA\u8A8D\u3001\u62C5\u5F53\u30AA\u30DA\u30EC\u30FC\u30BF\u30FC\u306EA.R.I.A\u3088\u3002\\n\u4EE5\u5F8C\u3088\u308D\u3057\u304F\u306D\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u3053\u3053\u306F\u8A13\u7DF4\u30B7\u30DF\u30E5\u30EC\u30FC\u30BF\u5185\u306E\u4EEE\u60F3\u7A7A\u9593\u3088\u3002\\n\u5B9F\u6226\u3067\u306E\u52D5\u304D\u65B9\u3084\u88C5\u5099\u306B\u3064\u3044\u3066\u8A13\u7DF4\u3059\u308B\u308F\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u307E\u305A\u306F\u5DE6\u30B9\u30C6\u30A3\u30C3\u30AF\u3092\u52D5\u304B\u3057\u3066\u3001\\n\u5468\u56F2\u3092\u8B66\u6212\u3057\u3064\u3064\u9053\u306A\u308A\u306B\u9032\u3093\u3067\u307F\u3066\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 1
  - message: "\u969C\u5BB3\u7269\u306F\u300CA\u30DC\u30BF\u30F3\u300D\u306E\u30B8\u30E3\u30F3\u30D7\u3067\\n\u98DB\u3073\u8D8A\u3048\u308B\u3068\u3044\u3044\u308F\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 1
  phase2_Zone1Reached:
  - message: "\u57FA\u672C\u7684\u306A\u79FB\u52D5\u306F\u554F\u984C\u306A\u3044\u3088\u3046\u306D\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u6B21\u306B\u3042\u306A\u305F\u306E\u30E1\u30A4\u30F3\u88C5\u5099\u306B\u3064\u3044\u3066\u3088\u3002\\n\u3088\u304F\u805E\u3044\u3066\u304A\u3044\u3066\u306D\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u3042\u306A\u305F\u306E\u9283\u306B\u306F\u3001\u78C1\u529B\u306E\u5F3E\u4E38\u3092\u6483\u3061\u51FA\u3057\u3066\\n\u78C1\u5834\u3092\u767A\u751F\u3055\u305B\u308B\u6A5F\u80FD\u304C\u3042\u308B\u306E\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "[LT]\u3092\u9577\u62BC\u3057\u3057\u306A\u304C\u3089[RT]\u3092\u62BC\u3057\u3066\u3001\\n\u8FD1\u304F\u306E\u30AF\u30EC\u30FC\u30C8\u3092\u6483\u3063\u3066\u307F\u3066\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 1
  phase3_CrateShot:
  - message: "\u30AF\u30EC\u30FC\u30C8\u304B\u3089\u30C9\u30FC\u30E0\u304C\u5C55\u958B\u3055\u308C\u305F\u3067\u3057\u3087\uFF1F\\n\u3053\u308C\u306F\u78C1\u5834\u304C\u53EF\u8996\u5316\u3055\u308C\u305F\u3082\u306E\u3088\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u3068\u3053\u308D\u3067\u78C1\u529B\u306B\u306F\u3001N\u3068S\u306E\uFF12\u3064\u306E\u78C1\u6975\u304C\\n\u3042\u308B\u306E\u306F\u77E5\u3063\u3066\u308B\u308F\u306D\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u540C\u3058\u78C1\u6975\u540C\u58EB\u306A\u3089\u53CD\u767A\u3057\u3001\\n\u7570\u306A\u308B\u78C1\u6975\u540C\u58EB\u306A\u3089\u5F15\u304D\u5BC4\u305B\u3042\u3046\u2026"
    messageWaitTime: 2
    hideBoardAfterThis: 1
  - message: "\u5B9F\u306F\u3042\u306A\u305F\u306E\u9283\u306B\u3082\u78C1\u6975\u306E\u5207\u308A\u66FF\u3048\u6A5F\u80FD\u304C\\n\u5099\u308F\u3063\u3066\u3044\u308B\u306E\u3002[RB]\u3092\u62BC\u3057\u3066\u307F\u3066\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 1
  phase4_MagnetSwitched:
  - message: "\u753B\u9762\u53F3\u4E0B\u306EUI\u304C\u5909\u3063\u305F\u308F\u306D\u3001\\n\u3053\u308C\u3067\u78C1\u6975\u306E\u5207\u308A\u66FF\u3048\u306F\u6210\u529F\u3088\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u3067\u306F\u305D\u306E\u307E\u307E\u5225\u306E\u30AF\u30EC\u30FC\u30C8\u3092\\n\u6483\u3063\u3066\u307F\u307E\u3057\u3087\u3046\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 1
  phase5_CratesConnected:
  - message: "\u7570\u306A\u308B\u78C1\u6975\u3092\u4ED8\u4E0E\u3057\u305F\u3053\u3068\u3067\u3001\\n\u30AF\u30EC\u30FC\u30C8\u540C\u58EB\u304C\u5F15\u304D\u5408\u3063\u305F\u308F\u306D\u3001\u6210\u529F\u3088\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u9006\u306B\u53CD\u767A\u3092\u8D77\u3053\u3057\u305F\u3044\u3068\u304D\u306F\u3001\\n\u540C\u3058\u78C1\u6975\u3092\u4ED8\u4E0E\u3059\u308C\u3070OK\u3088\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u305D\u3046\u305D\u3046\u3001\u753B\u9762\u53F3\u4E0B\u306EUI\u306F\u9283\u306E\u6B8B\u5F3E\u6570\u3082\\n\u793A\u3057\u3066\u3044\u308B\u306E\u3002[X]\u3067\u30EA\u30ED\u30FC\u30C9\u304C\u3067\u304D\u308B\u308F\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u305F\u3060\u3057\u3001\u30EA\u30ED\u30FC\u30C9\u3059\u308B\u3068\"\u4ED8\u4E0E\u3057\u305F\u78C1\u529B\u304C\\n\u30EA\u30BB\u30C3\u30C8\u3055\u308C\u308B\"\u304B\u3089\u6CE8\u610F\u3057\u3066\u3061\u3087\u3046\u3060\u3044\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 1
  phase6_WallReached:
  - message: "\u9AD8\u3044\u58C1\u306D...\u3067\u3082\u554F\u984C\u306A\u3044\u308F\u3002\\n\u3042\u306A\u305F\u306E\u9283\u306E\u6A5F\u80FD\u3092\u5FDC\u7528\u3059\u308C\u3070\u306D\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u5B9F\u306F\u3042\u306A\u305F\u306E\u9283\u306F\u3001\u3042\u306A\u305F\u81EA\u8EAB\u306B\u3082\\n\u78C1\u529B\u3092\u4ED8\u4E0E\u3067\u304D\u308B\u306E\u3002[LB]\u3092\u62BC\u3057\u3066\u307F\u3066\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  phase7_WallClimbed:
  - message: "\u898B\u3048\u308B\u304B\u3057\u3089\uFF1F\\n\u3042\u306A\u305F\u304B\u3089\u30C9\u30FC\u30E0\u304C\u5C55\u958B\u3055\u308C\u3066\u3044\u308B\u3067\u3057\u3087\uFF1F"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u3053\u308C\u3067\u3001\u3042\u306A\u305F\u81EA\u8EAB\u304C\u78C1\u529B\u306B\u5F71\u97FF\u3092\\n\u4E0E\u3048\u308B\u3089\u308C\u308B\u3088\u3046\u306B\u306A\u308B\u308F\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u305D\u308C\u306B\u3001\u3042\u306A\u305F\u304C\u7A7A\u4E2D\u306B\u5C45\u308B\u9593\u306F\\n\u3042\u306A\u305F\u81EA\u8EAB\u3082\u78C1\u529B\u306E\u5F71\u97FF\u3092\u53D7\u3051\u308B\u306E\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 1
  - message: "\u3064\u307E\u308A\u3001\u3042\u306A\u305F\u81EA\u8EAB\u304C\u5F15\u3063\u5F35\u3089\u308C\u305F\u308A\\n\u53CD\u767A\u3059\u308B\u3088\u3046\u306B\u306A\u308B\u306E\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 1
  - message: "\u3055\u3041\u3001\u3053\u308C\u3067\u3082\u3046\u308F\u304B\u3063\u305F\u308F\u3088\u306D\uFF1F\\n\u3053\u306E\u58C1\u3092\u4E57\u308A\u8D8A\u3048\u3066\u307F\u3066\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 1
  phase8_EnemySpotted:
  - message: "\u304B\u306A\u308A\u78C1\u529B\u3092\u4F7F\u3044\u3053\u306A\u3057\u59CB\u3081\u3066\u308B\u308F\u306D\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u3067\u3082\u672C\u756A\u306F\u3053\u3053\u304B\u3089\u3088\u3002\\n\u76EE\u306E\u524D\u306E\u4E0D\u6C17\u5473\u306A\u30ED\u30DC\u30C3\u30C8\u304C\u898B\u3048\u308B\uFF1F"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u3042\u308C\u304C\u8857\u306E\u5B89\u5168\u3092\u8105\u304B\u3059\u25CB\u25CB\u3002\\n\u5F7C\u7B49\u3092\u6392\u9664\u3059\u308B\u306E\u304C\u3042\u306A\u305F\u306E\u91CD\u8981\u306A\u4EFB\u52D9\u3088\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u3055\u3063\u305D\u304F\u6226\u95D8\u306E\u30B7\u30DF\u30E5\u30EC\u30FC\u30B7\u30E7\u30F3\u3092\\n\u304A\u3053\u306A\u3044\u307E\u3057\u3087\u3046\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u3053\u306E\u6575\u306F\u5DE8\u5927\u306A\u65A7\u3092\u632F\u308A\u56DE\u3057\u3066\u304F\u308B\u308F\u3002\\n\u78C1\u529B\u3067\u8DDD\u96E2\u3092\u53D6\u308B\u306E\u304C\u6709\u52B9\u3088\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 1
  phase9_BattleStart:
  - message: "\u305D\u3057\u3066\u3001\u3042\u306A\u305F\u306E\u9283\u306F\\n\u6575\u306B\u3082\u78C1\u529B\u3092\u4ED8\u4E0E\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u306E\u3002"
    messageWaitTime: 2
    hideBoardAfterThis: 0
  - message: "\u3055\u3063\u304D\u306E\u3088\u3046\u306B\u30AA\u30D6\u30B8\u30A7\u30AF\u30C8\u3092\u5F15\u304D\u5BC4\u305B\u3066\u3001\\n\u304A\u3082\u3044\u304D\u308A\u3076\u3064\u3051\u3066\u3084\u308A\u306A\u3055\u3044\uFF01"
    messageWaitTime: 2
    hideBoardAfterThis: 1
  phase10_EnemyDefeated:
  - message: "\u3055\u3059\u304C\u306D\u3001\u898B\u4E8B\u306A\u624B\u969B\u3060\u308F\u3002"
    messageWaitTime: 2
